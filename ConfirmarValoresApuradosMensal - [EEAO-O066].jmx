        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="PRÉ-CONDIÇÕES PARA O 1013: Verificar se há confirmação para o mes vigente " enabled="false">
          <boolProp name="TransactionController.parent">true</boolProp>
          <boolProp name="TransactionController.includeTimers">false</boolProp>
        </TransactionController>
        <hashTree>
          <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Verificar_existencia_dados_mes_corrente" enabled="true">
            <stringProp name="dataSource">dbConnection</stringProp>
            <stringProp name="query">select ee.ID_ENTIDADE_EMPREGADORA, 
pc.ID_PERIODO_CONFIRMACAO, pc.DATA_INICIO_PERIODO, pc.DATA_FIM_PERIODO, cee.ID_CONFIRMACAO_ENTIDADE_EMP from 
eeaoc.entidade_empregadora  ee
join EEAOC.PERIODO_CONFIRMACAO pc 
on pc.ID_ENTIDADE_EMPREGADORA = ee.ID_ENTIDADE_EMPREGADORA
join EEAOC.CONFIRMACAO_ENTIDADE_EMP cee
on cee.ID_PERIODO_CONFIRMACAO = pc.ID_PERIODO_CONFIRMACAO
 where ee.niss_ee = ${NISS_EE}
 order by DATA_INICIO_PERIODO desc
 fetch first 1 row only</stringProp>
            <stringProp name="queryArguments"></stringProp>
            <stringProp name="queryArgumentsTypes"></stringProp>
            <stringProp name="queryTimeout"></stringProp>
            <stringProp name="queryType">Select Statement</stringProp>
            <stringProp name="resultSetHandler">Store as String</stringProp>
            <stringProp name="resultSetMaxRows"></stringProp>
            <stringProp name="resultVariable"></stringProp>
            <stringProp name="variableNames">ID_ENTIDADE_EMPREGADORA, ID_PERIODO_CONFIRMACAO, DATA_INICIO_PERIODO, DATA_FIM_PERIODO, ID_CONFIRMACAO_ENTIDADE_EMP</stringProp>
          </JDBCSampler>
          <hashTree>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Teste para saber se data bate" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import java.text.SimpleDateFormat
import java.util.Calendar

def dataBancoStr = vars.get(&quot;DATA_FIM_PERIODO_1&quot;);

log.info(&quot;Data retorno banco: &quot; + dataBancoStr);

// FORMAT DATA bd
SimpleDateFormat sdf = new SimpleDateFormat(&quot;yyyy-MM-dd HH:mm:ss&quot;);
Date dataBanco = sdf.parse(dataBancoStr);


Date hoje = new Date()
Calendar calBanco = Calendar.getInstance()
calBanco.setTime(dataBanco)

Calendar calHoje = Calendar.getInstance()
calHoje.setTime(hoje)

// Comparar mês e ano
boolean mesmoMes =
        calBanco.get(Calendar.MONTH) == calHoje.get(Calendar.MONTH) &amp;&amp;
        calBanco.get(Calendar.YEAR) == calHoje.get(Calendar.YEAR)

if (mesmoMes) {
    log.info(&quot;Realizar update para conseguir confirmar Valores Apurados&quot;);
    vars.put(&quot;MES_CORRENTE&quot;, &quot;true&quot;);
} else {
    log.info(&quot;Mês corrente é DIFERENTE da DATA_INICIO_PERIODO&quot;);
     vars.put(&quot;MES_CORRENTE&quot;, &quot;false&quot;);
}
</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
