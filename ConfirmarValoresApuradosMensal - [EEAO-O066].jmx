            <stringProp name="query">UPDATE GRS.PARAMETRO
set NUMERICO_1 = ${DIA_CHUMBADO}
WHERE CODIGO_PARAMETRO=&apos;DVENCONFEE&apos;</stringProp>
            <stringProp name="queryArguments"></stringProp>
