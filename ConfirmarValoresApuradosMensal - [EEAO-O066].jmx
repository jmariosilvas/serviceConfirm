            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="DIA_CHUMBADO">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">vars.put(&quot;DIA_CHUMBADO&quot;,&quot;1&quot;) </stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="FINAL_DE_ANO">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.time.LocalDate
import java.time.DayOfWeek
import java.time.format.DateTimeFormatter

def formatter = DateTimeFormatter.ofPattern(&quot;yyyy-MM-dd&quot;)

// BASE (DEZEMBRO DO ANO ATUAL)
def ano = LocalDate.now().getYear()

def diaChumbado = Integer.parseInt(vars.get(&quot;DIA_CHUMBADO&quot;) ?: &quot;1&quot;)

def dataBase = LocalDate.of(ano, 12, diaChumbado)


//próximo dia útil 
def proximoDiaUtil = { data -&gt;
    def d = data
    while (d.dayOfWeek == DayOfWeek.SATURDAY || d.dayOfWeek == DayOfWeek.SUNDAY) {
        d = d.plusDays(1)
    }
    return d
}

// próximo dia útil com avanço (para INÍCIO)
def proximoDiaUtilComAvanco = { data -&gt;
    def d = data.plusDays(1) 

    while (d.dayOfWeek == DayOfWeek.SATURDAY || d.dayOfWeek == DayOfWeek.SUNDAY) {
        d = d.plusDays(1)
    }
    return d
}


// DATA_INICIO_RESULTADO
def dataInicioResultado = proximoDiaUtilComAvanco(dataBase)


// DATA_FIM_RESULTADO
def dataFimResultado = {
    def d = dataBase
    if (d.monthValue == 1 &amp;&amp; d.dayOfMonth == 1) {
        d = d.plusDays(1)
    }
    return proximoDiaUtil(d)
}()

vars.put(&quot;DATA_INICIO_RESULTADO&quot;, dataInicioResultado.format(formatter))
vars.put(&quot;DATA_FIM_RESULTADO&quot;, dataFimResultado.format(formatter))

// ==========================
// LOG
// ==========================
log.warn(&quot;&quot;&quot;
DATA_BASE...............: ${dataBase}
DATA_INICIO_RESULTADO...: ${vars.get(&apos;DATA_INICIO_RESULTADO&apos;)}
DATA_FIM_RESULTADO......: ${vars.get(&apos;DATA_FIM_RESULTADO&apos;)}
&quot;&quot;&quot;)</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
