          </JDBCSampler>
          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="FINAL_DE_SEMANA" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.time.LocalDate
import java.time.DayOfWeek
import java.time.format.DateTimeFormatter

def formatter = DateTimeFormatter.ISO_DATE
def hoje = LocalDate.now()

//O dia desejaD
def diaSemana = vars.get(&quot;DIA_SEMANA&quot;) ?: &quot;SATURDAY&quot;

def diaDesejado = DayOfWeek.valueOf(diaSemana.toUpperCase())
def ajustarDiaUtil = { data -&gt;
    switch (data.dayOfWeek) {
        case DayOfWeek.SATURDAY:
            return data.plusDays(2)
        case DayOfWeek.SUNDAY:
            return data.plusDays(1)
        default:
            return data
    }
}

// Próximo mE^s
def proximoMes = hoje.plusMonths(1)
// Procura o PRIMEIRO dia desejado no próximo mês
def diaEncontrado = null
for (int i = 1; i &lt;= proximoMes.lengthOfMonth(); i++) {
    def data = proximoMes.withDayOfMonth(i)
    if (data.dayOfWeek == diaDesejado) {
        diaEncontrado = i
        break
    }
}
//DIA_RESULTADO
vars.put(&quot;DIA_RESULTADO&quot;, diaEncontrado.toString())

def dataFimOriginal = proximoMes.withDayOfMonth(diaEncontrado)
def dataFimResultado = ajustarDiaUtil(dataFimOriginal)

vars.put(&quot;DATA_FIM_RESULTADO&quot;, dataFimResultado.format(formatter))

log.warn(&quot;&quot;&quot;
DIA_FIM_SEMANA........: ${diaSemana}
DIA_ENCONTRADO........: ${diaEncontrado}
DATA_FIM_ORIGINAL.....: ${dataFimOriginal}
DIA_DA_SEMANA.........: ${dataFimOriginal.dayOfWeek}
DATA_FIM_RESULTADO....: ${vars.get(&apos;DATA_FIM_RESULTADO&apos;)}

&quot;&quot;&quot;)</stringProp>
            </JSR223PreProcessor>
