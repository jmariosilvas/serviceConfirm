            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="VALIDAR RETORNO DOS DADOS" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">def response = vars.get(&quot;ID_SERVICE_AUDIT_RESPONSE_#&quot;)
log.info(&quot;\nvalor de resposnse :${response}&quot;)

if (response != null &amp;&amp; response.toInteger() &lt; 1) {
    prev.setSuccessful(false) 
    prev.setResponseMessage(&quot;AUDITORIA SEM DADOS&quot;)
}</stringProp>
            </JSR223PostProcessor>
