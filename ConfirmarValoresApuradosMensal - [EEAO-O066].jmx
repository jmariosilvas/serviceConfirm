          <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="1. Verifica Existencia_dados_mes_corrente" enabled="true">
            <stringProp name="dataSource">dbConnection</stringProp>
            <stringProp name="query">select ee.ID_ENTIDADE_EMPREGADORA, 
pc.ID_PERIODO_CONFIRMACAO, pc.DATA_INICIO_PERIODO, pc.DATA_FIM_PERIODO, cee.ID_CONFIRMACAO_ENTIDADE_EMP from 
eeaoc.entidade_empregadora  ee
join EEAOC.PERIODO_CONFIRMACAO pc 
on pc.ID_ENTIDADE_EMPREGADORA = ee.ID_ENTIDADE_EMPREGADORA
LEFT join EEAOC.CONFIRMACAO_ENTIDADE_EMP cee
on cee.ID_PERIODO_CONFIRMACAO = pc.ID_PERIODO_CONFIRMACAO
where ee.niss_ee = ${NISS_EE}
AND EXTRACT(MONTH FROM pc.DATA_INICIO_PERIODO) = ${MOTH}</stringProp>
            <stringProp name="queryArguments"></stringProp>
            <stringProp name="queryArgumentsTypes"></stringProp>
            <stringProp name="queryTimeout"></stringProp>
            <stringProp name="queryType">Select Statement</stringProp>
            <stringProp name="resultSetHandler">Store as String</stringProp>
            <stringProp name="resultSetMaxRows"></stringProp>
            <stringProp name="resultVariable"></stringProp>
            <stringProp name="variableNames">ID_ENTIDADE_EMPREGADORA, ID_PERIODO_CONFIRMACAO, DATA_INICIO_PERIODO, DATA_FIM_PERIODO, ID_CONFIRMACAO_ENTIDADE_EMP</stringProp>
          </JDBCSampler>
          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="MOTH_CURRENT" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.time.LocalDate

def now = LocalDate.now()
vars.put(&quot;MOTH&quot;, now.getMonthValue().toString())
log.info(&quot;MOTH_CURRENT: &quot; + now.getMonthValue())
</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="HAS_DATA" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">def count = vars.get(&quot;ID_PERIODO_CONFIRMACAO_#&quot;) as Integer ?: 0

if (count &gt; 0) 
{
    prev.setSuccessful(true);
    prev.setResponseMessage(&quot;Registros encontrados: &quot; + count);
    vars.put(&quot;MES_CORRENTE&quot;,&quot;true&quot;);
} 
else
{
    prev.setSuccessful(false);
    prev.setResponseMessage(&quot;FALHOU - Nenhum registro encontrado&quot;);
}</stringProp>
            </JSR223PostProcessor>
