      <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="CHECK_DATA_INICIO_BD" enabled="true">
        <stringProp name="cacheKey">true</stringProp>
        <stringProp name="filename"></stringProp>
        <stringProp name="parameters"></stringProp>
        <stringProp name="script">
if (props.get(&apos;CHECKDATABDINI&apos;) == &quot;true&quot;) {
	log.warn(&quot;USANDO TESTES COMUNS CHECKDATADB&quot;)
	String dataBanco = vars.get(&quot;DATA_INICIO_PERIODO_1&quot;)
	String dataEsperada = vars.get(&quot;DATA_INICIO_RESULTADO&quot;)
	
	log.warn(&quot;&quot;&quot;
	Data Banco...........: ${dataBanco}
	Data Esperada........: ${dataEsperada}
	&quot;&quot;&quot;)
	
	if(dataBanco == null)
	{
		vars.put(&quot;LOOP&quot;, &quot;PROCEED&quot;)
	}
	else if (!dataBanco.contains(dataEsperada)) {
	
	    prev.setSuccessful(false)
	    prev.setResponseMessage(&quot;[FAIL] VALIDAÇÃO da DATA_INICIO_PERIODO&quot;)
	    prev.setResponseCode(&quot;500&quot;)
	    log.error(&quot;[FAIL] VALIDAÇÃO da DATA_INICIO_PERIODO&quot;)
	    vars.put(&quot;LOOP&quot;, &quot;STOP&quot;)
	
	} else {
	    log.warn(&quot;A DATA_INICIO_PERIODO está correta.&quot;)
	    prev.setResponseMessage(&quot;[PASS] VALIDAÇÃO da DATA_INICIO_PERIODO&quot;)
	    vars.put(&quot;LOOP&quot;, &quot;STOP&quot;)
	}
	log.warn(&quot;&quot;&quot;
Data Esperada: ${dataEsperada}
Data Retornada:${dataBanco}

&quot;&quot;&quot;)
	
	log.warn(&quot;Data Esperada:&quot;+dataEsperada+&quot; Data Retornada: &quot;+dataBanco)
	log.warn(&quot;Finalizando testes desse caso de testes.&quot;)
     props.put(&quot;CHECKDATABDINI&quot;,&quot;false&quot;)

}
