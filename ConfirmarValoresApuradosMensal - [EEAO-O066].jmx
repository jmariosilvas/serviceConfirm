          <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="1. Verifica Existencia_dados_mes_corrente">
            <stringProp name="dataSource">dbConnection</stringProp>
            <stringProp name="query">select ee.ID_ENTIDADE_EMPREGADORA, 
pc.ID_PERIODO_CONFIRMACAO, pc.DATA_INICIO_PERIODO, pc.DATA_FIM_PERIODO, cee.ID_CONFIRMACAO_ENTIDADE_EMP from 
eeaoc.entidade_empregadora  ee
join EEAOC.PERIODO_CONFIRMACAO pc 
on pc.ID_ENTIDADE_EMPREGADORA = ee.ID_ENTIDADE_EMPREGADORA
LEFT join EEAOC.CONFIRMACAO_ENTIDADE_EMP cee
on cee.ID_PERIODO_CONFIRMACAO = pc.ID_PERIODO_CONFIRMACAO
where ee.niss_ee = ${NISS_EE}
AND EXTRACT(MONTH FROM pc.DATA_INICIO_PERIODO) = ${MONTH}</stringProp>
            <stringProp name="queryArguments"></stringProp>
            <stringProp name="queryArgumentsTypes"></stringProp>
