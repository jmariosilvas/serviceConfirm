          </JDBCSampler>
          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="next_SUNDAY" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.time.LocalDate
import java.time.DayOfWeek
import java.time.format.DateTimeFormatter


//#DIA_RESULTADO
int diaResultado = 5


// ANO DINÂMICO
int ano = LocalDate.now().year + 1


// COMEÇAMOS EM 01/JANEIRO
LocalDate data = LocalDate.of(ano, 1, diaResultado)


// FERIADOS FIXOS
def isFeriado = { d -&gt;
    (d.monthValue == 1 &amp;&amp; d.dayOfMonth == 1)
}


// AJUSTAR SE NÃO FOR DIA ÚTIL
while (
    data.dayOfWeek == DayOfWeek.SATURDAY ||
    data.dayOfWeek == DayOfWeek.SUNDAY ||
    isFeriado(data)
) {
    data = data.plusDays(1)
}


// RESULTADO FINAL
String dataResultado = data.format(DateTimeFormatter.ofPattern(&quot;yyyy-MM-dd&quot;))

vars.put(&quot;DIA_RESULTADO&quot;, String.valueOf(diaResultado))
vars.put(&quot;DATA_RESULTADO&quot;, dataResultado)

log.info(&quot;DIA_RESULTADO: &quot; + diaResultado)
log.info(&quot;DATA_RESULTADO ajustada: &quot; + dataResultado)</stringProp>
            </JSR223PreProcessor>
