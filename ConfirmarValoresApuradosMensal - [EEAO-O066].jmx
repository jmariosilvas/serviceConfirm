      <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="CHECK_DATA_DATA_FIM_BD" enabled="true">
        <stringProp name="cacheKey">true</stringProp>
        <stringProp name="filename"></stringProp>
        <stringProp name="parameters"></stringProp>
        <stringProp name="script">
if (props.get(&apos;CHECKDATABD&apos;) == &quot;true&quot;) {
	log.warn(&quot;USANDO TESTES COMUNS CHECKDATADB&quot;)
	String dataBanco = vars.get(&quot;DATA_FIM_PERIODO_1&quot;)
	String dataEsperada = vars.get(&quot;DATA_FIM_RESULTADO&quot;)
	
	log.warn(&quot;Data Banco: &quot; + dataBanco)
	log.warn(&quot;Data Esperada: &quot; + dataEsperada)
	
	if(dataBanco == null)
	{
		vars.put(&quot;LOOP&quot;, &quot;PROCEED&quot;)
	}
	else if (!dataBanco.contains(dataEsperada)) {
	
	    prev.setSuccessful(false)
	    prev.setResponseMessage(&quot;[FAIL] VALIDAÇÃO da DATA_FIM_PERIODO&quot;)
	    prev.setResponseCode(&quot;500&quot;)
	    vars.put(&quot;LOOP&quot;, &quot;STOP&quot;)
	    log.error(&quot;[FAIL] VALIDAÇÃO da DATA_FIM_PERIODO&quot;)
	
	} else {
	    log.warn(&quot;A DATA_FIM_PERIODO está correta.&quot;)
	    prev.setResponseMessage(&quot;VALIDAÇÃO da DATA_FIM_PERIODO [PASS]&quot;)
	    vars.put(&quot;LOOP&quot;, &quot;STOP&quot;)
	}
	
	log.warn(&quot;Data Esperada:&quot;+dataEsperada+&quot; Data Retornada: &quot;+dataBanco)
	log.warn(&quot;Finalizando testes desse caso de testes.&quot;)
     props.put(&quot;CHECKDATABD&quot;,&quot;false&quot;)

}
</stringProp>
