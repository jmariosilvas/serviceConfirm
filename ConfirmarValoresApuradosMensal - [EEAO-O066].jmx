            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="next_friday_V2" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.time.LocalDate
import java.time.DayOfWeek
import java.time.temporal.TemporalAdjusters
import java.time.format.DateTimeFormatter

LocalDate hoje = LocalDate.now()

String diaSemana = vars.get(&quot;DIA_SEMANA&quot;) ?: &quot;FRIDAY&quot;
DayOfWeek diaDesejado = DayOfWeek.valueOf(diaSemana)

LocalDate proximoDia = hoje.with(TemporalAdjusters.next(diaDesejado)
)
String dia = proximoDia.getDayOfMonth().toString()
vars.put(&quot;DIA_RESULTADO&quot;, dia)

String dataCompleta = proximoDia.format(DateTimeFormatter.ofPattern(&quot;yyyy-MM-dd&quot;))
vars.put(&quot;DATA_RESULTADO&quot;, dataCompleta)
log.info(&quot;Próximo ${diaSemana}: ${proximoDia}&quot;)
log.info(&quot;Dia: ${dia}&quot;)
log.info(&quot;Data completa: ${dataCompleta}&quot;)</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
