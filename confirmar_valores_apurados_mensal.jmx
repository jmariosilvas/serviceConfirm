            <stringProp name="resultSetMaxRows"></stringProp>
            <stringProp name="resultVariable"></stringProp>
            <stringProp name="variableNames">CODIGO_PARAMETRO, NUMERICO_1, OBSERVACOES</stringProp>
          </JDBCSampler>
