    //ID_ENTIDADE_EMPREGADORA
    vars.put(&quot;IDENTIDADEEMPREGADORA&quot;,salveValue)
    log.info(&quot;O Valor ID_ENTIDADE_EMPREGADORA é tratado HAS_DATA: &quot;+salveValue)
    
} 
else
{
    prev.setSuccessful(false);
    prev.setResponseMessage(&quot;FALHOU - Nenhum registro encontrado&quot;);
}</stringProp>
