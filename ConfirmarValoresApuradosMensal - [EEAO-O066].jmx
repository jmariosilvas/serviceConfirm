          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="minusMonths">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.time.LocalDate

def now = LocalDate.now().minusMonths(1)

vars.put(&quot;MONTH&quot;, now.getMonthValue().toString())
log.info(&quot;MONTH_PREVIOUS: &quot; + now.getMonthValue())
</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="HAS_DATA">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">def count = vars.get(&quot;ID_PERIODO_CONFIRMACAO_#&quot;) as Integer ?: 0
def salveValue = vars.get(&quot;ID_ENTIDADE_EMPREGADORA_1&quot;).toString()
if (count &gt; 0) 
{
    prev.setSuccessful(true);
    prev.setResponseMessage(&quot;Registros encontrados: &quot; + count);
    vars.put(&quot;MES_CORRENTE&quot;,&quot;true&quot;);
    //ID_ENTIDADE_EMPREGADORA
    vars.put(&quot;IDENTIDADEEMPREGADORA&quot;,salveValue)
    log.info(&quot;O Valor ID_ENTIDADE_EMPREGADORA é tratado HAS_DATA: &quot;+salveValue)
    
} 
else
{
    prev.setSuccessful(false);
    prev.setResponseMessage(&quot;FALHOU - Nenhum registro encontrado&quot;);
}</stringProp>
