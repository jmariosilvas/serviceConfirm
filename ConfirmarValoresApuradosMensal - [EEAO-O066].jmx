              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">String dataBanco = vars.get(&quot;DATA_FIM_PERIODO_1&quot;)
String dataEsperada = vars.get(&quot;DATA_RESULTADO&quot;)

log.info(&quot;Data Banco: &quot; + dataBanco)
log.info(&quot;Data Esperada: &quot; + dataEsperada)

if (dataBanco == null || !dataBanco.contains(dataEsperada)) {

    prev.setSuccessful(false)
    prev.setResponseMessage(&quot;VALIDAÇÃO da DATA_FIM_PERIODO [FAIL]&quot;)
    prev.setResponseCode(&quot;500&quot;)

    log.error(&quot;VALIDAÇÃO da DATA_FIM_PERIODO [FAIL]&quot;)

} else {

    log.info(&quot;A DATA_FIM_PERIODO está correta.&quot;)
    prev.setResponseMessage(&quot;VALIDAÇÃO da DATA_FIM_PERIODO [PASS]&quot;)
}</stringProp>
