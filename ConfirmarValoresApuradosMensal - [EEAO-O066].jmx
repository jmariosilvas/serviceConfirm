          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="FINAL_DE_SEMANA" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.time.LocalDate
import java.time.DayOfWeek
import java.time.temporal.TemporalAdjusters
import java.time.format.DateTimeFormatter

def formatter = DateTimeFormatter.ISO_DATE
def hoje = LocalDate.now()

def diaSemana = vars.get(&quot;DIA_SEMANA&quot;) ?: &quot;SATURDAY&quot;
def diaDesejado = DayOfWeek.valueOf(diaSemana.toUpperCase())

def ajustarDiaUtil = { data -&gt;
    switch (data.dayOfWeek) {
        case DayOfWeek.SATURDAY:
            return data.plusDays(2)

        case DayOfWeek.SUNDAY:
            return data.plusDays(1)

        default:
            return data
    }
}

// Próximo dia desejado
def proximoDia = hoje.with(TemporalAdjusters.next(diaDesejado))

vars.put(&quot;DIA_RESULTADO&quot;, proximoDia.dayOfMonth.toString())
vars.put(&quot;DATA_RESULTADO&quot;, proximoDia.format(formatter))

// DATA_INICIO_RESULTADO = +1 dia
def dataInicio = proximoDia.plusDays(1)

// Ajusta se cair final de semana
dataInicio = ajustarDiaUtil(dataInicio)

vars.put(&quot;DATA_INICIO_RESULTADO&quot;, dataInicio.format(formatter))

// DATA_FIM_RESULTADO = mesmo dia no mês seguinte
def dataFim = proximoDia.plusMonths(1)

// Ajusta se cair final de semana
dataFim = ajustarDiaUtil(dataFim)

vars.put(&quot;DATA_FIM_RESULTADO&quot;, dataFim.format(formatter))

log.warn(&quot;&quot;&quot;
DATA_RESULTADO........: ${vars.get(&apos;DATA_RESULTADO&apos;)}
DATA_INICIO_RESULTADO.: ${vars.get(&apos;DATA_INICIO_RESULTADO&apos;)}
DATA_FIM_RESULTADO....: ${vars.get(&apos;DATA_FIM_RESULTADO&apos;)}
&quot;&quot;&quot;)</stringProp>
