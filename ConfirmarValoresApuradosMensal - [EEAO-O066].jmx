            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="next_SATURDAY">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.time.LocalDate
import java.time.DayOfWeek
import java.time.format.DateTimeFormatter
import java.time.temporal.TemporalAdjusters

// Data de referência (hoje)
def hoje = LocalDate.now()

// Dia da semana desejado (padrão: SATURDAY)
def diaSemana = vars.get(&quot;DIA_SEMANA&quot;) ?: &quot;SATURDAY&quot;
def diaDesejado = DayOfWeek.valueOf(diaSemana.toUpperCase())

// Próximo dia da semana desejado
def proximoDia = hoje.with(TemporalAdjusters.next(diaDesejado))

// Salvar dia e data completa
vars.put(&quot;DIA_RESULTADO&quot;, proximoDia.dayOfMonth.toString())
vars.put(&quot;DATA_RESULTADO&quot;, proximoDia.format(DateTimeFormatter.ISO_DATE))

// DATA_FIM_RESULTADO = mesmo dia do mês seguinte
def dataFimResultado = proximoDia.plusMonths(1)
vars.put(&quot;DATA_FIM_RESULTADO&quot;, dataFimResultado.format(DateTimeFormatter.ISO_DATE))

log.info(&quot;DIA_RESULTADO: ${vars.get(&apos;DIA_RESULTADO&apos;)}, DATA_RESULTADO: ${vars.get(&apos;DATA_RESULTADO&apos;)}, DATA_FIM_RESULTADO: ${vars.get(&apos;DATA_FIM_RESULTADO&apos;)}&quot;)</stringProp>
            </JSR223PreProcessor>
