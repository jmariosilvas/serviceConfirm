              <stringProp name="script">def response = vars.get(&quot;RESPONSE_1&quot;)
log.info(&quot;valor de resposnse : \n${response}&quot;)

if (response == null || !response.contains(&quot;403&quot;)) {
    prev.setSuccessful(false) 
