            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="FRAB.SERVIDOR_FRAB" enabled="true">
              <stringProp name="dataSource">ptecConnection</stringProp>
              <stringProp name="query">SELECT 
  e.IDENTIFICADOR_EXECUCAO, 
  i.VERSAO_SUBSISTEMA, 
  B.Identificador_Batch, 
  e.UNIDADES_CANDIDATAS AS UN_CAND, 
  e.ERROS,   
  ae.VALOR_SIMPLES, 
  EE.DESIGNACAO ESTADO, 
  e.PILHA_ERRO_RAZAO, 
  e.CONTROLO_CONCORRENCIA, 
  erro.classe_erro, 
  erro.mensagem_erro, 
  erro.pilha_erro 
FROM     FRAB.SERVIDOR_FRAB s 
    INNER JOIN FRAB.INSTALACAO_BATCH i ON i.SERVIDOR=s.IDENTIFICACAO_SERVIDOR 
    INNER JOIN FRAB.BATCH_FRAB b ON b.IDENTIFICACAO_SEQUENCIAL = i.BATCH 
    INNER JOIN FRAB.execucao_frab e ON e.INSTALACAO_BATCH = i.IDENTIFICACAO_SEQUENCIAL 
    INNER JOIN FRAB.estado_execucao ee ON ee.CODIGO_ESTADO_EXECUCAO = e.ESTADO 
    INNER JOIN FRAB.ARGUMENTO_EXECUCAO ae ON ae.IDENTIFICADOR_EXECUCAO  = e.IDENTIFICADOR_EXECUCAO 
    LEFT JOIN FRAB.ERRO_FRAB erro ON ae.IDENTIFICADOR_EXECUCAO  = erro.IDENTIFICADOR_EXECUCAO 
WHERE 1=1  
    AND I.Versao_Subsistema LIKE &apos;EEAOC-${versaoApp}&apos;
    and e.IDENTIFICADOR_EXECUCAO = &apos;${EXECUTION_ID}&apos; and  ae.NOME = &apos;NISS_EE&apos;
order by e.DATA_INICIO desc</stringProp>
              <stringProp name="queryArguments"></stringProp>
              <stringProp name="queryArgumentsTypes"></stringProp>
              <stringProp name="queryTimeout"></stringProp>
              <stringProp name="queryType">Select Statement</stringProp>
              <stringProp name="resultSetHandler">Store as String</stringProp>
              <stringProp name="resultSetMaxRows"></stringProp>
              <stringProp name="resultVariable"></stringProp>
              <stringProp name="variableNames">IDENTIFICADOR_EXECUCAO, VERSAO_SUBSISTEMA, IDENTIFICADOR_BATCH, UN_CAND, ERROS, VALOR_SIMPLES, ESTADO, PILHA_ERRO_RAZAO, CONTROLO_CONCORRENCIA, CLASSE_ERRO, MENSAGEM_ERRO, PILHA_ERRO</stringProp>
            </JDBCSampler>
            <hashTree>
              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="VALIDA_FIM_DO_BATCH" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">String valorBanco = vars.get(&quot;ESTADO_1&quot;) ?: &quot;NULL&quot;
String valorEsperado = &quot;ENDED_WITH_SUCCESS&quot;

log.warn(&quot;Valor na coluna Estado do banco: &quot; + valorBanco)

if (!valorEsperado.contains(valorBanco)) {
    prev.setResponseMessage(&quot;[FAIL] ESTADO != ENDED_WITH_SUCCESS&quot;)
    vars.put(&quot;batch&quot;, &quot;CONT&quot;)
    prev.setResponseCode(&quot;500&quot;)
} else {

    prev.setResponseMessage(&quot;[PASS] ESTADO = ENDED_WITH_SUCCESS &quot;)
    vars.put(&quot;READY&quot;, &quot;STOP&quot;)
    vars.put(&quot;LOOP&quot;, &quot;NULL&quot;)
    log.warn(&quot;ESTADO Esperado:&quot;+valorEsperado+&quot; ESTADO RetornadO: &quot;+valorBanco)
}
 

</stringProp>
              </JSR223PostProcessor>
